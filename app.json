{
  "expo": {
    "name": "Girok",
    "slug": "girok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "girok",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.girok.app",
      "config": {
        "googleMapsApiKey": "AIzaSyD1XdJG3tO_o8O1BSJZx-VMokru276jvNQ"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090B11"
      },
      "package": "com.girok.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD1XdJG3tO_o8O1BSJZx-VMokru276jvNQ"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Girok needs camera access to scan boarding passes and tickets."
        }
      ],
      "expo-font",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyD1XdJG3tO_o8O1BSJZx-VMokru276jvNQ",
          "androidGoogleMapsApiKey": "AIzaSyD1XdJG3tO_o8O1BSJZx-VMokru276jvNQ"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
